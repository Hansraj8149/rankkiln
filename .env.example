# Platform key (hosted plans). Self-hosters put their own key here.
ANTHROPIC_API_KEY=
# Model used for briefs and drafts. Pick a current Claude model id.
RANKKILN_MODEL=

# Hosted only
RESEND_API_KEY=
RANKKILN_FROM_EMAIL=
# 32-byte base64 key that encrypts customer credentials and BYO API keys at rest (AES-GCM)
RANKKILN_ENCRYPTION_KEY=

# Search Console (self-hosted: a Desktop app OAuth client; hosted: a Web app client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Self-hosted only: printed by `pnpm rankkiln gsc-login`
GOOGLE_REFRESH_TOKEN=

# Platform secrets named by tokenEnv in rankkiln.config.ts, e.g.
# ACME_WP_APP_PASSWORD=
